rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can read round state (needed so student.html can show status
    // without logging in). Writes aren't locked to "sir" specifically —
    // see README.md, "Security note" — but a create must start a round
    // correctly, and updates are left open so sir.html's close/reveal
    // actions work without any auth setup.
    match /rounds/{roundId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'open';
      allow update: if true;
      allow delete: if true;
    }

    // Anyone can read bids (so the class can see standings). A bid can only
    // be written while its round is still open, and only the expected
    // fields/types are accepted.
    match /bids/{bidId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['roundId', 'name', 'amount', 'submittedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 60
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0
                    && get(/databases/$(database)/documents/rounds/$(request.resource.data.roundId)).data.status == 'open';
      allow delete: if true;
    }
  }
}
